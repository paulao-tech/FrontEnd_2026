<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simulador Infinity Bank</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .container {
            background-color: white;
            padding: 30px;
            border-radius: 10px;
            width: 360px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        h1 {
            text-align: center;
            margin-bottom: 20px;
        }

        label {
            font-weight: bold;
        }

        input, select {
            width: 100%;
            padding: 10px;
            margin: 6px 0 15px;
            font-size: 16px;
            border-radius: 5px;
            border: 1px solid #ccc;
        }

        button {
            width: 100%;
            padding: 10px;
            font-size: 16px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            background-color: #111827;
            color: white;
        }

        button:hover {
            background-color: #374151;
        }

        #resultado {
            margin-top: 20px;
            padding: 15px;
            border-radius: 5px;
            background-color: #e8f4ff;
            color: #003366;
            font-weight: bold;
            line-height: 1.6;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Infinity Bank</h1>

        <label for="bandeira">Bandeira</label>
        <select id="bandeira">
            <option value="visa">Visa - 2%</option>
            <option value="master">Master - 1.85%</option>
            <option value="elo">Elo - 3%</option>
        </select>

        <label for="valor">Valor da venda</label>
        <input type="number" id="valor" step="0.01" placeholder="Ex: 1000">

        <label for="parcelas">Número de parcelas</label>
        <input type="number" id="parcelas" min="1" placeholder="Ex: 5">

        <button id="calcular">Simular Venda</button>

        <div id="resultado"></div>
    </div>

    <script>
        const botao = document.getElementById("calcular");

        botao.addEventListener("click", function() {

            const bandeira = document.getElementById("bandeira").value;
            const valorVenda = Number(document.getElementById("valor").value);
            const quantidadeParcelas = Number(document.getElementById("parcelas").value);
            const resultado = document.getElementById("resultado");

            let taxaPercentual = 0;

            switch (bandeira) {
                case "visa":
                    taxaPercentual = 0.02;
                    break;

                case "master":
                    taxaPercentual = 0.0185;
                    break;

                case "elo":
                    taxaPercentual = 0.03;
                    break;
            }

            const valorTaxa = valorVenda * taxaPercentual;

            const valorJuros = valorVenda * (0.0035 * quantidadeParcelas);

            const taxaMensal = 12.50 * quantidadeParcelas;

            const valorTotal = valorVenda + valorTaxa + valorJuros + taxaMensal;

            const valorParcela = valorTotal / quantidadeParcelas;

            resultado.innerHTML = `
                Valor da venda: R$ ${valorVenda.toFixed(2)}<br>
                Valor da Taxa da Bandeira: R$ ${valorTaxa.toFixed(2)}<br>
                Valor dos Juros: R$ ${valorJuros.toFixed(2)}<br>
                Taxa mensal: R$ ${taxaMensal.toFixed(2)}<br>
                Valor total: R$ ${valorTotal.toFixed(2)}<br>
                Valor de cada parcela: R$ ${valorParcela.toFixed(2)}
            `;
        });
    </script>

</body>
</html>
